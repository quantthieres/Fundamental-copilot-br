{
  "name": "fundamental-copilot-br",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run coverage:audit:models && npm run report:audit && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cvm:audit": "tsx scripts/check-cvm-financials.ts",
    "cvm:audit:json": "tsx scripts/check-cvm-financials.ts --json",
    "cvm:precompute": "tsx scripts/precompute-cvm-cache.ts",
    "cvm:precompute:quarterly": "NODE_OPTIONS='--max-old-space-size=4096' tsx scripts/precompute-cvm-quarterly-cache.ts",
    "time-series:precompute": "tsx scripts/precompute-time-series-cache.ts",
    "cvm:audit:quarterly": "tsx scripts/audit-quarterly.ts",
    "forecast:precompute:baseline": "tsx scripts/precompute-baseline-forecasts.ts",
    "coverage:audit": "tsx scripts/audit-b3-coverage.ts",
    "coverage:audit:cvm-gaps": "tsx scripts/audit-cvm-coverage-gaps.ts",
    "bank:precompute": "tsx scripts/precompute-bank-cache.ts",
    "fii:precompute": "tsx scripts/precompute-fii-cache.ts",
    "fii:audit:distributions": "tsx scripts/audit-fii-distributions.ts",
    "insurance:precompute": "tsx scripts/precompute-insurance-cache.ts",
    "coverage:audit:models": "tsx scripts/audit-model-routing.ts",
    "report:audit": "tsx scripts/audit-report-routes.ts",
    "coverage:audit:quote-only": "tsx scripts/audit-quote-only-coverage.ts",
    "coverage:audit:readiness": "tsx scripts/audit-asset-readiness.ts",
    "cache:audit:freshness": "tsx scripts/audit-cache-freshness.ts",
    "macro:precompute": "tsx scripts/precompute-macro-cache.ts"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "fflate": "^0.8.2",
    "next": "^15.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
